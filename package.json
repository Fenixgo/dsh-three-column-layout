{
  "name": "@fenixgo/dsh-three-column-layout",
  "version": "1.3.0",
  "description": "三栏应用布局：60px 应用栏、默认 280px 应用第二栏和内容区。",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "layout",
    "three-column",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fenixgo/dsh-three-column-layout.git"
  },
  "bugs": {
    "url": "https://github.com/Fenixgo/dsh-three-column-layout/issues"
  },
  "homepage": "https://github.com/Fenixgo/dsh-three-column-layout#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
